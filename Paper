<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="牌值計算器">
<title>牌值計算器</title>
<style>
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}
body {
  margin: 0;
  background: #f2f2f7;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  text-align: center;
}
.container {
  max-width: 500px;
  margin: auto;
  padding: 20px 15px;
}
h1 {
  margin: 10px 0 5px;
}
.status {
  background: white;
  border-radius: 20px;
  padding: 20px;
  margin: 15px 0;
}
#color {
  font-size: 42px;
  font-weight: bold;
}
#score {
  font-size: 24px;
  margin-top: 5px;
}
.cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}
button {
  border: none;
  border-radius: 15px;
  background: white;
  font-size: 24px;
  font-weight: bold;
  padding: 20px 5px;
  box-shadow: 0 2px 6px #0002;
}
button:active {
  transform: scale(0.94);
}
.reset {
  width: 100%;
  margin-top: 15px;
  background: #111;
  color: white;
}
.history {
  background: white;
  border-radius: 15px;
  padding: 15px;
  margin-top: 15px;
  text-align: left;
  min-height: 50px;
  word-break: break-all;
}
</style>
</head>
<body>
<div class="container">
<h1>🃏 牌值計算器</h1>
<div class="status">
  <div id="color">⚪</div>
  <div id="score">0</div>
</div>
<div class="cards">
<button onclick="addCard('1',1)">1</button>
<button onclick="addCard('2',1)">2</button>
<button onclick="addCard('3',1)">3</button>
<button onclick="addCard('4',1)">4</button>
<button onclick="addCard('5',0)">5</button>
<button onclick="addCard('6',0)">6</button>
<button onclick="addCard('7',-1)">7</button>
<button onclick="addCard('8',-1)">8</button>
<button onclick="addCard('9',-1)">9</button>
<button onclick="addCard('10',0)">10</button>
<button onclick="addCard('J',0)">J</button>
<button onclick="addCard('Q',0)">Q</button>
<button onclick="addCard('K',0)">K</button>
</div>
<button class="reset" onclick="resetGame()">
🔄 新的一手
</button>
<div class="history">
<b>本手牌：</b>
<span id="history"></span>
</div>
</div>
<script>
let score = 0;
let cards = [];
function addCard(card, value) {
  cards.push(card);
  score += value;
  update();
}
function update() {
  document.getElementById("score").textContent =
    score > 0 ? "+" + score : score;
  if (score > 0) {
    document.getElementById("color").textContent = "🔴 紅";
  } 
  else if (score < 0) {
    document.getElementById("color").textContent = "🔵 藍";
  } 
  else {
    document.getElementById("color").textContent = "⚪ 0";
  }
  document.getElementById("history").textContent =
    cards.join(" ");
}
function resetGame() {
  score = 0;
  cards = [];
  update();
}
</script>
</body>
</html>
